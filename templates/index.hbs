<html>
    <head>
        <title>{{title}}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism.min.css">
        {{#if externalCssIncludes}}
        <style>
            {{#each externalCssIncludes}}
            @import url('{{{this}}}');
            {{/each}}
        </style>
        {{/if}}
        {{#each headIncludes}}
        <link rel="stylesheet" href="{{this}}">
        {{/each}}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(160deg, #007cf0, #00dfd8);">
            <div class="container">
                <a class="navbar-brand fw-bold" href="./index.html">StyleScribe</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link active" href="./index.html">Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Components
                            </a>
                            <ul class="dropdown-menu">
                                {{#each groups as |groupComponents groupName|}}
                                <li><h6 class="dropdown-header">{{groupName}}</h6></li>
                                {{#each groupComponents}}
                                <li><a class="dropdown-item" href="./components/{{this.name}}.html">{{this.title}}</a></li>
                                {{/each}}
                                {{/each}}
                            </ul>
                        </li>
                        {{#each navigation.pages}}
                        <li class="nav-item">
                            <a class="nav-link" href="./{{this.slug}}.html">{{this.title}}</a>
                        </li>
                        {{/each}}
                    </ul>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <div style="width: 100%; min-height: 280px; background: linear-gradient(160deg, #007cf0, #00dfd8); display: flex; align-items: center; justify-content: center;">
            <div class="container text-center">
                <div class="text-white">
                    <h1 class="display-2 fw-light mb-3">{{title}}</h1>
                    <p class="lead opacity-75 mb-4">A modern CSS/SCSS documentation generator with design tokens support</p>
                    <div class="d-flex gap-3 justify-content-center">
                        <a href="./getting-started.html" class="btn btn-light btn-lg">Get Started</a>
                        <a href="#components" class="btn btn-outline-light btn-lg">View Components</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="container mt-5">
            {{{content}}}

            <section id="components" class="mt-5">
                <h2 class="mb-4">Component Library</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px;">
                    {{#each groups as |components group|}}
                    <div class="card h-100">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">{{group}}</h5>
                        </div>
                        <div class="list-group list-group-flush">
                            {{#each components as |component|}}
                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="./components/{{component.name}}.html">
                                {{component.title}}
                                <span class="badge bg-secondary">{{component.variations.length}} variants</span>
                            </a>
                            {{/each}}
                        </div>
                    </div>
                    {{/each}}
                </div>
            </section>
        </div>

        <footer class="bg-light py-4 mt-5">
            <div class="container text-center text-muted">
                <p class="mb-0">Built with <strong>StyleScribe</strong> - CSS/SCSS Documentation Generator</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
